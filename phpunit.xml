<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         stopOnFailure="false">

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <!--
            Live: the compiler executed against real engines. Included in the
            default run ON PURPOSE — each driver SKIPS with a reason when it is
            not configured or not answering, so "3 of 4 engines were not tested"
            stays visible instead of being a suite nobody remembers to run.
            Configure with LETMIGRATE_DB_MYSQL / _PGSQL / _SQLSRV (GROUND_DB_*
            is honoured too); SQLite needs nothing.
        -->
        <testsuite name="Live">
            <directory>tests/Live</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <ini name="error_reporting" value="-1"/>
    </php>
</phpunit>
