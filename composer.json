{
  "name": "alfacode-team/let-migrate",
  "description": "Enterprise-grade, multi-database PHP migration engine. Standalone module with its own namespace — works independently or alongside any PHP project.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "migration",
    "database",
    "schema",
    "mysql",
    "postgresql",
    "sqlite",
    "sqlserver",
    "enterprise",
    "psr-4"
  ],
  "authors": [
    {
      "name": "AlfaCode Team",
      "email": "shamavurasheed@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "AlfaCode\\LetMigrate\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AlfaCode\\LetMigrate\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test":        "phpunit --no-coverage",
    "test:unit":   "phpunit --testsuite Unit --no-coverage",
    "test:int":    "phpunit --testsuite Integration --no-coverage",
    "phpstan":     "phpstan analyse --memory-limit=256M"
  }
}
